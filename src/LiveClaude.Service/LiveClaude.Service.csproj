<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LiveClaude.Service</AssemblyName>
    <RootNamespace>LiveClaude.Service</RootNamespace>
    <UserSecretsId>liveclaude-service</UserSecretsId>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Windowed on Windows, on purpose: a console-owning process hands its console to every child, which
    makes Windows ignore the pseudo-console attribute and breaks the embedded terminal. CLI commands
    attach to the caller's console at runtime instead (see ConsoleBridge in the Windows platform).
    POSIX has no such rule — a pty slave is the child's controlling terminal either way — so there the
    supervisor is a plain console executable and its output goes where it was started from.
  -->
  <PropertyGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>
  <PropertyGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' != 'true'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <!--
      Both of these are no-ops off their own platform: AddWindowsService only registers its lifetime
      when the process really is a Windows service, AddSystemd only when systemd started it. That is
      why they can be called unconditionally below.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveClaude.Abstractions\LiveClaude.Abstractions.csproj" />
    <ProjectReference Include="..\LiveClaude.Core\LiveClaude.Core.csproj" />
  </ItemGroup>

  <!--
    The platform assembly is loaded by name at runtime, never linked: referencing it would drag a
    net10.0-windows target into this project and make it unbuildable elsewhere. These references
    exist only so the right one lands next to the executable during development; a published package
    ships exactly one of them.
  -->
  <Import Project="..\..\build\PlatformAssemblies.props" />

</Project>
