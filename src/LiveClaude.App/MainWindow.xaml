<Window x:Class="LiveClaude.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LiveClaude.App.Views"
        Title="LiveClaude" Height="820" Width="1280"
        MinHeight="620" MinWidth="960"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">

  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="LiveClaude" FontSize="22" FontWeight="Bold" />
          <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="8,3" Margin="12,4,0,0"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding ConnectionText}" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
          </Border>
        </StackPanel>
        <TextBlock Text="{Binding ClaudeInfo}" Style="{StaticResource Mono}" Margin="0,6,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        <Button Content="New session" Style="{StaticResource PrimaryButton}" Command="{Binding NewSessionCommand}" />
      </StackPanel>
    </Grid>

    <!-- Tabs -->
    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
      <TabItem Header="Dashboard">
        <views:DashboardView />
      </TabItem>
      <TabItem Header="Sessions">
        <views:SessionsView />
      </TabItem>
      <TabItem Header="Terminal">
        <views:TerminalPane x:Name="TerminalTab" />
      </TabItem>
      <TabItem Header="Logs">
        <views:LogsView />
      </TabItem>
      <TabItem Header="Environments">
        <views:EnvironmentsView />
      </TabItem>
      <TabItem Header="Service &amp; startup">
        <views:SettingsView />
      </TabItem>
    </TabControl>

    <!-- Footer -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
      <TextBlock Style="{StaticResource Mono}" Text="Config:" Margin="0,0,6,0" />
      <TextBlock Style="{StaticResource Mono}" Text="%ProgramData%\LiveClaude\config.json" Margin="0,0,16,0" />
      <Button Content="Open config folder" Command="{Binding OpenConfigCommand}" Padding="8,3" FontSize="11.5" />
      <Button Content="Open logs folder" Command="{Binding OpenLogFolderCommand}" Padding="8,3" FontSize="11.5" />
    </StackPanel>
  </Grid>
</Window>
