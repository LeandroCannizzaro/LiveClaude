<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LiveClaude.App.Views.SettingsView"
             Background="{DynamicResource SurfaceBrush}">
  <Grid Margin="20" RowDefinitions="Auto,Auto,*">

    <!-- Top command bar -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
      <StackPanel Grid.Column="0">
        <TextBlock Text="Service &amp; startup" Classes="heading" />
        <TextBlock Text="{Binding Hosting.SupervisorBuild}" Classes="mono" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Refresh status" Command="{Binding RefreshCommand}" Margin="0" />
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="1" Classes="subheading" Margin="0,6,0,10"
               Text="Pick who keeps the servers alive when this window is closed. The host that runs in your own signed-in session is the safest default; the system-wide one starts even before you sign in, but must run under your account to reach CLI credentials." />

    <!-- No-scroll tabbed layout -->
    <TabControl Grid.Row="2">

      <!-- The host that runs in the signed-in session: scheduled task, systemd user unit, LaunchAgent. -->
      <TabItem Header="User session host">
        <Border Classes="card" DataContext="{Binding Hosting.UserHost}" Margin="0,12,0,0" VerticalAlignment="Top">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" />
              <Border Classes="pill" Margin="10,1,0,0">
                <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" />
              </Border>
              <TextBlock Text="recommended" Foreground="{DynamicResource SuccessBrush}" FontSize="11.5" Margin="10,2,0,0" />
            </StackPanel>

            <TextBlock Classes="subheading" Margin="0,8,0,4" Text="{Binding Summary}" />
            <TextBlock Classes="subheading" Margin="0,0,0,10"
                       Text="{Binding StartBeforeSignInRequirement}"
                       IsVisible="{Binding StartBeforeSignInRequirement, Converter={StaticResource HasText}}" />

            <StackPanel Orientation="Horizontal">
              <Button Content="Install / update" Classes="primary" Click="OnInstallUserHost" />
              <Button Content="Start" Click="OnStartUserHost" />
              <Button Content="Stop" Click="OnStopUserHost" />
              <Button Content="Remove" Click="OnRemoveUserHost" Margin="0" />
            </StackPanel>

            <TextBlock Text="{Binding Result}" Classes="mono" Margin="0,12,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                       IsVisible="{Binding HasResult}" />
          </StackPanel>
        </Border>
      </TabItem>

      <!-- The machine-wide host, where the platform has one: Windows service, systemd system unit, LaunchDaemon. -->
      <TabItem Header="System-wide host" IsVisible="{Binding Hosting.HasSystemHost}">
        <Border Classes="card" DataContext="{Binding Hosting.SystemHost}" Margin="0,12,0,0" VerticalAlignment="Top">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" />
              <Border Classes="pill" Margin="10,1,0,0">
                <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" />
              </Border>
            </StackPanel>

            <TextBlock Classes="subheading" Margin="0,8,0,4" Text="{Binding Summary}" />
            <TextBlock Classes="subheading" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,6"
                       Text="Run it as your own account: the system account has a different profile and will not find your CLI credentials." />

            <Grid ColumnDefinitions="*,*" IsVisible="{Binding SupportsAccount}">
              <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Account" Classes="field" />
                <TextBox Text="{Binding $parent[UserControl].DataContext.Hosting.Account}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="10,0,0,0" IsVisible="{Binding RequiresPassword}">
                <TextBlock Text="Password (used once during the install, never stored)" Classes="field" />
                <TextBox Name="ServicePassword" PasswordChar="●" />
              </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button Content="Install" Click="OnInstallSystemHost" />
              <Button Content="Start" Click="OnStartSystemHost" />
              <Button Content="Stop" Click="OnStopSystemHost" />
              <Button Content="Remove" Click="OnRemoveSystemHost" Margin="0" />
            </StackPanel>

            <TextBlock Text="{Binding Result}" Classes="mono" Margin="0,12,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                       IsVisible="{Binding HasResult}" />
          </StackPanel>
        </Border>
      </TabItem>

    </TabControl>
  </Grid>
</UserControl>
