<UserControl x:Class="LiveClaude.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <TextBlock Text="Service &amp; startup" Style="{StaticResource Heading}" />
      <TextBlock Style="{StaticResource SubHeading}"
                 Text="Pick who keeps the servers alive when this window is closed. The scheduled task runs in your own session and is the safest default; the Windows service starts even before you sign in, but must run under your account to reach the Claude Code credentials." />

      <!-- Scheduled task -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Scheduled task" FontSize="15" FontWeight="SemiBold" />
            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="8,2" Margin="10,1,0,0">
              <TextBlock Text="{Binding Hosting.TaskStatus}" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
            </Border>
            <TextBlock Text="recommended" Foreground="{StaticResource SuccessBrush}" FontSize="11.5" Margin="10,2,0,0" />
          </StackPanel>

          <TextBlock Style="{StaticResource SubHeading}" Margin="0,8,0,4"
                     Text="Triggers at logon and 30 seconds after boot, restarts every minute if it fails, never stops on battery, no time limit." />
          <TextBlock Style="{StaticResource SubHeading}" Margin="0,0,0,10"
                     Text="Windows only lets an administrator register the boot trigger, so installing asks for elevation. Decline it and the task is still installed for logon only — everything works except starting before anyone signs in." />

          <StackPanel Orientation="Horizontal">
            <Button Content="Install / update task" Style="{StaticResource PrimaryButton}" Click="OnInstallTask" />
            <Button Content="Start" Click="OnStartTask" />
            <Button Content="Stop" Click="OnStopTask" />
            <Button Content="Remove" Click="OnRemoveTask" />
          </StackPanel>

          <TextBlock Text="{Binding Hosting.TaskResult}" Style="{StaticResource Mono}" Margin="0,12,0,0"
                     TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                     Visibility="{Binding Hosting.HasTaskResult, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Border>

      <!-- Windows service -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Windows service" FontSize="15" FontWeight="SemiBold" />
            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="8,2" Margin="10,1,0,0">
              <TextBlock Text="{Binding Hosting.ServiceStatus}" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
            </Border>
          </StackPanel>

          <TextBlock Style="{StaticResource SubHeading}" Margin="0,8,0,4"
                     Text="Installed with automatic start and sc.exe failure actions (restart after 5s, 10s, then every 30s). Installation asks for elevation." />
          <TextBlock Style="{StaticResource SubHeading}" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,6"
                     Text="Run it as your own Windows account: LocalSystem has a different profile and will not find the Claude Code sign-in." />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Text="Account" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Hosting.Account, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="Windows password (used once by sc.exe, never stored)" Style="{StaticResource FieldLabel}" />
              <PasswordBox x:Name="ServicePassword" />
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Install service" Click="OnInstallService" />
            <Button Content="Start" Click="OnStartService" />
            <Button Content="Stop" Click="OnStopService" />
            <Button Content="Remove" Click="OnRemoveService" />
          </StackPanel>

          <TextBlock Text="{Binding Hosting.ServiceResult}" Style="{StaticResource Mono}" Margin="0,12,0,0"
                     TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                     Visibility="{Binding Hosting.HasServiceResult, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Border>

      <!-- Claude CLI -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Claude Code CLI" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource SubHeading}" Margin="0,8,0,0"
                     Text="Prefer a stable native install: the copy bundled with the Claude desktop app lives in a versioned folder whose path changes on every update." />

          <TextBlock Text="Path (leave empty to auto-detect)" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding ClaudePath, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Detected installs" Style="{StaticResource FieldLabel}" />
          <ItemsControl ItemsSource="{Binding DetectedInstalls}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Style="{StaticResource Mono}" FontSize="11">
                      <Run Text="{Binding Version}" />
                      <Run Text=" — " />
                      <Run Text="{Binding Source}" />
                    </TextBlock>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Use" Click="OnUseInstall" Tag="{Binding Path}" Padding="10,3" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Restart policy -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Restart policy" FontSize="15" FontWeight="SemiBold" />
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Text="First retry (s)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding BackoffInitialSeconds, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0,10,0">
              <TextBlock Text="Max backoff (s)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding BackoffMaxSeconds, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="10,0,10,0">
              <TextBlock Text="Max restarts (0 = forever)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding BackoffMaxRestarts, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="10,0,0,0">
              <TextBlock Text="Log file size (MB)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding LogMaxSizeMb, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>

          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Text="Clean shutdown wait (s)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding GracefulStopSeconds, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
              <TextBlock Style="{StaticResource Mono}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                         Text="Stopping sends Ctrl+C and waits this long before terminating. The CLI uses that window to deregister its bridge environment — a hard kill is what leaves dead entries in the session picker." />
              <CheckBox Content="Track which environment each server registers (needs the Anthropic API)"
                        IsChecked="{Binding TrackEnvironments}" Margin="0,0,0,0" />
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" />
            <Button Content="Reconnect to supervisor" Command="{Binding ReconnectCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
