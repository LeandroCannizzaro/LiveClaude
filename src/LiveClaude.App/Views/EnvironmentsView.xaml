<UserControl x:Class="LiveClaude.App.Views.EnvironmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
  <Grid Margin="20" DataContext="{Binding Environments}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Environments on your account" Style="{StaticResource Heading}" />
      <TextBlock Style="{StaticResource SubHeading}"
                 Text="Every 'claude remote-control' process registers a bridge environment, and it stays registered after the process is gone — that is why the picker in Claude Desktop shows the same project several times, one live and the rest dead. Delete the leftovers here. LiveClaude never selects an environment that a running server is using." />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
      <Button Content="Refresh" Command="{Binding RefreshCommand}" />
      <Button Content="Select duplicates" Style="{StaticResource PrimaryButton}"
              ToolTip="Keeps the live one — or the newest — for each directory and selects the rest."
              Command="{Binding SelectDuplicatesCommand}" />
      <Button Content="Select stale" Command="{Binding SelectStaleCommand}" />
      <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" />
      <Button Content="Delete selected" Command="{Binding DeleteSelectedCommand}" />
      <Button Command="{Binding ForceDeleteCommand}"
              Visibility="{Binding CanForce, Converter={StaticResource BoolToVisibility}}"
              ToolTip="These still have session records attached. Forcing deletes those too.">
        <TextBlock>
          <Run Text="Force delete (" /><Run Text="{Binding ForceCandidateCount, Mode=OneWay}" /><Run Text=")" />
        </TextBlock>
      </Button>
      <Button Content="Open log" Command="{Binding OpenLogCommand}" />
      <CheckBox Content="Show non-bridge environments" IsChecked="{Binding ShowUnrelated}" Margin="12,0,0,0"
                VerticalAlignment="Center" />
    </StackPanel>

    <!-- What went wrong last time, in front of the user rather than only in the log file. -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12"
            Background="#2A1E18" BorderBrush="{StaticResource DangerBrush}"
            Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="The last delete did not finish" FontWeight="SemiBold" FontSize="13"
                   Foreground="{StaticResource DangerBrush}" Margin="0,0,0,6" />
        <TextBlock Text="{Binding FailureSummary}" Style="{StaticResource Mono}" TextWrapping="Wrap"
                   Foreground="{StaticResource TextBrush}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}" Padding="14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          IsEnabled="{Binding CanSelect}" Margin="0,0,14,0" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{Binding UsageBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UsageText}" Foreground="{Binding UsageBrush}" FontSize="11.5"
                               VerticalAlignment="Center" Margin="10,1,0,0" />
                  </StackPanel>
                  <TextBlock Text="{Binding Directory}" Style="{StaticResource Mono}" Margin="17,5,0,0" />
                  <StackPanel Orientation="Horizontal" Margin="17,3,0,0">
                    <TextBlock Style="{StaticResource Mono}" FontSize="11" Text="{Binding Machine}" />
                    <TextBlock Style="{StaticResource Mono}" FontSize="11" Text="  ·  " />
                    <TextBlock Style="{StaticResource Mono}" FontSize="11" Text="{Binding Created}" />
                    <TextBlock Style="{StaticResource Mono}" FontSize="11" Text="  " />
                    <TextBlock Style="{StaticResource Mono}" FontSize="11" Text="{Binding Branch}" />
                  </StackPanel>

                  <TextBlock Text="{Binding Note}" Style="{StaticResource Mono}" FontSize="11"
                             Margin="17,7,0,0" TextWrapping="Wrap"
                             Foreground="{StaticResource SuccessBrush}"
                             Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />

                  <TextBlock Text="{Binding LastError}" Style="{StaticResource Mono}" FontSize="11"
                             Margin="17,7,0,0" TextWrapping="Wrap"
                             Foreground="{StaticResource DangerBrush}"
                             Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding Id}" Style="{StaticResource Mono}" FontSize="11"
                           VerticalAlignment="Center" Opacity="0.6" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
      <TextBlock Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="16,0,0,0">
        <Run Text="stale:" />
        <Run Text="{Binding StaleCount, Mode=OneWay}" />
        <Run Text="   selected:" />
        <Run Text="{Binding SelectedCount, Mode=OneWay}" />
      </TextBlock>
    </StackPanel>
  </Grid>
</UserControl>
