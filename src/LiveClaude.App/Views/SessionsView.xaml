<UserControl x:Class="LiveClaude.App.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LiveClaude.App.ViewModels"
             Background="{StaticResource SurfaceBrush}">
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- List -->
    <DockPanel Grid.Column="0" Margin="0,0,20,0">
      <TextBlock DockPanel.Dock="Top" Text="Sessions" Style="{StaticResource Heading}" />
      <Button DockPanel.Dock="Bottom" Content="New session" Style="{StaticResource PrimaryButton}"
              Command="{Binding NewSessionCommand}" Margin="0,12,0,0" />
      <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance, Mode=TwoWay}">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Root" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8"
                          Padding="12,10" BorderThickness="1" BorderBrush="Transparent">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock Text="{Binding Directory}" Style="{StaticResource Mono}" FontSize="11" Margin="16,3,0,0"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Editor -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" DataContext="{Binding Editor}">
      <StackPanel>
        <TextBlock Text="Session parameters" Style="{StaticResource Heading}" />
        <TextBlock Style="{StaticResource SubHeading}"
                   Text="These map one-to-one onto the flags of 'claude remote-control'. The command preview at the bottom shows exactly what the supervisor will run." />

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Name (shown at claude.ai/code)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Project directory" Style="{StaticResource FieldLabel}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Content="Browse…" Click="OnBrowse" Margin="8,0,0,0" />
            </Grid>

            <WrapPanel>
              <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Margin="0,10,20,0" />
              <CheckBox Content="Start with the supervisor" IsChecked="{Binding AutoStart}" Margin="0,10,20,0" />
              <CheckBox Content="Pre-create a session in this directory" IsChecked="{Binding CreateSessionInDir}" Margin="0,10,20,0" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Text="Spawn mode" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding Source={x:Static vm:SessionEditorViewModel.SpawnModes}}"
                        SelectedItem="{Binding Spawn}" />
              <TextBlock Style="{StaticResource Mono}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="same-dir: every session shares this folder · worktree: each remote session gets its own git worktree · session: exactly one session" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="Permission mode" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding Source={x:Static vm:SessionEditorViewModel.PermissionModes}}"
                        SelectedItem="{Binding PermissionMode}" />
              <TextBlock Style="{StaticResource Mono}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="acceptEdits or auto keep the server moving when nobody is at the keyboard." />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Text="Capacity (max concurrent sessions)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Capacity, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="Model override (optional)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Text="Session name prefix (optional)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding SessionNamePrefix, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="Fixed session id (optional)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding SessionId, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
              <TextBlock Text="Extra arguments (appended verbatim)" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding ExtraArgs, UpdateSourceTrigger=PropertyChanged}" />

              <WrapPanel>
                <CheckBox Content="Reattach to the previous session after a restart (--continue)"
                          IsChecked="{Binding ContinuePrevious}" Margin="0,12,20,0" />
                <CheckBox Content="Sandbox" IsChecked="{Binding Sandbox}" Margin="0,12,20,0" />
                <CheckBox Content="Verbose" IsChecked="{Binding Verbose}" Margin="0,12,20,0" />
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}">
          <StackPanel>
            <TextBlock Text="Command preview" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
            <TextBlock Text="{Binding CommandPreview}" Style="{StaticResource Mono}" TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}" />
            <Button Content="Update preview" Click="OnUpdatePreview" HorizontalAlignment="Left" Margin="0,10,0,0"
                    Padding="8,3" FontSize="11.5" />
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
          <Button Content="Save session" Style="{StaticResource PrimaryButton}"
                  Command="{Binding DataContext.SaveSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          <Button Content="Trust this directory…" Click="OnTrustDirectory" />
          <Button Content="Run remote-control once…" Click="OnRunOnce" />
          <Button Content="Delete"
                  Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
