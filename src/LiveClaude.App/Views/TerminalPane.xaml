<UserControl x:Class="LiveClaude.App.Views.TerminalPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:term="clr-namespace:LiveClaude.Terminal.Controls;assembly=LiveClaude.Terminal"
             Background="{StaticResource SurfaceBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Embedded terminal" Style="{StaticResource Heading}" />
      <TextBlock Style="{StaticResource SubHeading}"
                 Text="A real pseudo console (ConPTY) inside the app. Use it to accept workspace trust for a new directory, answer the one-time Remote Control confirmation, sign in with /login — or to watch and steer a supervised server live." />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}" Padding="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="Attach to" VerticalAlignment="Center" Margin="0,0,8,0"
                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
        <ComboBox Grid.Column="1" x:Name="InstancePicker" ItemsSource="{Binding Instances}"
                  DisplayMemberPath="Name" SelectionChanged="OnInstancePicked" VerticalAlignment="Center" />

        <TextBlock Grid.Column="2" Text="Directory" VerticalAlignment="Center" Margin="16,0,8,0"
                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
        <TextBox Grid.Column="3" x:Name="DirectoryBox" VerticalAlignment="Center" />

        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0">
          <Button Content="Browse…" Click="OnBrowse" />
          <Button Content="Open claude here" Style="{StaticResource PrimaryButton}" Click="OnOpenClaude" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" CornerRadius="10" Background="#0C0C0C" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" Padding="8" ClipToBounds="True">
      <term:TerminalView x:Name="Terminal" />
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="0,0,16,0"
                 Text="Not attached." />
      <Button Content="Stop" Click="OnStop" />
      <Button Content="Clear" Click="OnClear" />
      <Button Content="Copy screen" Click="OnCopy" />
      <Button Content="Paste" Click="OnPaste" />
      <Button Content="Send Ctrl+C" Click="OnSendCtrlC" />
    </StackPanel>
  </Grid>
</UserControl>
