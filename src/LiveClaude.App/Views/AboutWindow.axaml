<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveClaude.App.Views.AboutWindow"
        Title="About LiveClaude"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

  <Border Classes="card" Margin="20" Padding="24">
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" VerticalAlignment="Top">
          <TextBlock Text="&gt;_" FontFamily="{StaticResource MonoFont}" FontSize="17" FontWeight="Bold"
                     Foreground="{StaticResource AccentBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Margin="14,0,0,0">
          <TextBlock Text="LiveClaude" FontSize="22" FontWeight="Bold" />
          <TextBlock Name="VersionText" Classes="mono" Margin="0,2,0,0" />
        </StackPanel>
      </StackPanel>

      <TextBlock Classes="subheading" Margin="0,16,0,0" TextWrapping="Wrap"
                 Text="Keeps Claude Code Remote Control servers running on Windows, Linux and macOS: one supervised server per project directory, restarted after a crash, at sign-in and after a reboot — hosted by whatever the operating system offers. Includes an embedded terminal for the flows that need one, and cleanup of the bridge environments that pile up on your account." />

      <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="14,12" Margin="0,4,0,0">
        <StackPanel>
          <TextBlock Text="Copyright (c) 2026 Leandro Cannizzaro" FontSize="12.5" />
          <TextBlock Classes="mono" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="Released under the MIT License. The software is provided &quot;as is&quot;, without warranty of any kind, express or implied." />
          <TextBlock Classes="mono" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Independent project — not affiliated with, endorsed by or sponsored by Anthropic. Claude and Claude Code are trademarks of Anthropic." />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
        <Button Content="Repository" Click="OnOpenRepository" />
        <Button Content="Product page" Click="OnOpenProductPage" />
        <Button Content="License" Click="OnOpenLicense" />
        <Button Content="Close" Classes="primary" Click="OnClose" Margin="0" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
