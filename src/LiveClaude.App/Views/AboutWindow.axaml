<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveClaude.App.Views.AboutWindow"
        Title="About LiveClaude"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

  <Border Classes="card" Margin="20" Padding="24">
    <StackPanel>
      <Border CornerRadius="12" ClipToBounds="True" Height="175" Margin="0,0,0,18"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Image Source="avares://LiveClaude/Assets/about-banner.png" Stretch="UniformToFill" />
      </Border>

      <Grid ColumnDefinitions="Auto,*">
        <Border Grid.Column="0" Width="76" Height="76" CornerRadius="14"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                Padding="10" VerticalAlignment="Top">
          <Image Source="avares://LiveClaude/Assets/liveclaude.png" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="1" Margin="16,2,0,0" VerticalAlignment="Center">
          <TextBlock Text="LiveClaude" FontSize="22" FontWeight="Bold" />
          <TextBlock Name="VersionText" Classes="mono" Margin="0,4,0,0" />
          <TextBlock Classes="mono" FontSize="11" Margin="0,4,0,0"
                     Text="Multi-product supervisor: Claude Code · Cursor · Antigravity" />
        </StackPanel>
      </Grid>

      <TextBlock Classes="subheading" Margin="0,16,0,0" TextWrapping="Wrap"
                 Text="Keeps Remote Control and worker agent sessions alive on Windows, Linux, and macOS: one supervised CLI process per project directory, automatically restarted after a crash, at sign-in, or after a reboot — with an embedded terminal, bridge environment cleanup, and customizable themes." />

      <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="14,12" Margin="0,4,0,0">
        <StackPanel>
          <TextBlock Text="Copyright (c) 2026 Leandro Cannizzaro" FontSize="12.5" />
          <TextBlock Classes="mono" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="Released under the MIT License. The software is provided &quot;as is&quot;, without warranty of any kind, express or implied." />
          <TextBlock Classes="mono" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Independent open-source project — not affiliated with, endorsed by, or sponsored by Anthropic, Cursor, or Google." />
        </StackPanel>
      </Border>

      <WrapPanel Margin="0,18,0,0">
        <Button Content="User Manual" Click="OnOpenProductPage" />
        <Button Content="Release Notes" Click="OnOpenReleaseNotes" />
        <Button Content="Repository" Click="OnOpenRepository" />
        <Button Content="License" Click="OnOpenLicense" />
        <Button Content="Close" Classes="primary" Click="OnClose" Margin="0" />
      </WrapPanel>
    </StackPanel>
  </Border>
</Window>
