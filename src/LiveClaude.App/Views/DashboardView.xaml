<UserControl x:Class="LiveClaude.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Remote Control servers" Style="{StaticResource Heading}" />
      <TextBlock Style="{StaticResource SubHeading}"
                 Text="One supervised 'claude remote-control' server per project directory. The supervisor restarts them on crash, at logon and after a reboot." />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Instances}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="10" Height="10" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="12"
                                 VerticalAlignment="Center" Margin="10,1,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding Directory}" Style="{StaticResource Mono}" Margin="18,6,0,0" />
                    <TextBlock Text="{Binding Details}" Style="{StaticResource Mono}" Margin="18,3,0,0" />

                    <TextBlock Text="{Binding Message}" Style="{StaticResource Mono}" Margin="18,6,0,0"
                               TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                               Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="{Binding SessionUrl}" Margin="14,8,0,0" Padding="8,3" FontSize="11.5"
                            HorizontalAlignment="Left"
                            Visibility="{Binding HasSessionUrl, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding DataContext.OpenSessionUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding SessionUrl}" />
                  </StackPanel>

                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Start" IsEnabled="{Binding CanStart}"
                            Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Id}" />
                    <Button Content="Stop" IsEnabled="{Binding CanStop}"
                            Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Id}" />
                    <Button Content="Restart"
                            Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Id}" />
                    <Button Content="Terminal" Click="OnAttachTerminal" Tag="{Binding Id}" />
                    <Button Content="Edit"
                            Command="{Binding DataContext.EditSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" Margin="0" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource Card}" Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                Visibility="{Binding Instances.Count, Converter={StaticResource CountToVisibility}}">
          <StackPanel>
            <TextBlock Text="No sessions yet" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource SubHeading}" Margin="0,6,0,10"
                       Text="Add a project directory in the Sessions tab. LiveClaude will start a Remote Control server there and keep it alive." />
            <Button Content="Create the first session" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Left" Command="{Binding NewSessionCommand}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
