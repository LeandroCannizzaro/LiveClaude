<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LiveClaude.App.Views.EnvironmentsView"
             Background="{StaticResource SurfaceBrush}">
  <Grid Margin="20" DataContext="{Binding Environments}" RowDefinitions="Auto,Auto,Auto,*,Auto">

    <StackPanel Grid.Row="0">
      <TextBlock Text="Environments on your account" Classes="heading" />
      <TextBlock Classes="subheading"
                 Text="Every remote-control process registers a bridge environment, and it stays registered after the process is gone — that is why the picker in Claude Desktop shows the same project several times, one live and the rest dead. Delete the leftovers here. LiveClaude never selects an environment that a running server is using." />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
      <Button Content="Refresh" Command="{Binding RefreshCommand}" />
      <Button Content="Select duplicates" Classes="primary"
              ToolTip.Tip="Keeps the live one — or the newest — for each directory and selects the rest."
              Command="{Binding SelectDuplicatesCommand}" />
      <Button Content="Select stale" Command="{Binding SelectStaleCommand}" />
      <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" />
      <Button Content="Delete selected" Command="{Binding DeleteSelectedCommand}"
              ToolTip.Tip="Stops a matching server first if one is still restarting, and forces the delete automatically if session records are still attached." />
      <Button Content="Open log" Command="{Binding OpenLogCommand}" />
      <CheckBox Content="Show non-bridge environments" IsChecked="{Binding ShowUnrelated}" Margin="12,0,0,0"
                VerticalAlignment="Center" />
    </StackPanel>

    <!-- What went wrong last time, in front of the user rather than only in the log file. -->
    <Border Grid.Row="2" Classes="card" Padding="14,12" Margin="0,0,0,12"
            Background="#2A1E18" BorderBrush="{StaticResource DangerBrush}"
            IsVisible="{Binding HasFailures}">
      <StackPanel>
        <TextBlock Text="The last delete did not finish" FontWeight="SemiBold" FontSize="13"
                   Foreground="{StaticResource DangerBrush}" Margin="0,0,0,6" />
        <TextBlock Text="{Binding FailureSummary}" Classes="mono" TextWrapping="Wrap"
                   Foreground="{StaticResource TextBrush}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Background="{StaticResource SurfaceAltBrush}" Padding="14">
              <Grid ColumnDefinitions="Auto,*,Auto">

                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          IsEnabled="{Binding CanSelect}" Margin="0,0,14,0" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{Binding UsageBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UsageText}" Foreground="{Binding UsageBrush}" FontSize="11.5"
                               VerticalAlignment="Center" Margin="10,1,0,0" />
                  </StackPanel>
                  <TextBlock Text="{Binding Directory}" Classes="mono" Margin="17,5,0,0" />
                  <StackPanel Orientation="Horizontal" Margin="17,3,0,0">
                    <TextBlock Classes="mono" FontSize="11" Text="{Binding Machine}" />
                    <TextBlock Classes="mono" FontSize="11" Text="  ·  " />
                    <TextBlock Classes="mono" FontSize="11" Text="{Binding Created}" />
                    <TextBlock Classes="mono" FontSize="11" Text="  " />
                    <TextBlock Classes="mono" FontSize="11" Text="{Binding Branch}" />
                  </StackPanel>

                  <TextBlock Text="{Binding Note}" Classes="mono" FontSize="11"
                             Margin="17,7,0,0" TextWrapping="Wrap"
                             Foreground="{StaticResource SuccessBrush}"
                             IsVisible="{Binding HasNote}" />

                  <TextBlock Text="{Binding LastError}" Classes="mono" FontSize="11"
                             Margin="17,7,0,0" TextWrapping="Wrap"
                             Foreground="{StaticResource DangerBrush}"
                             IsVisible="{Binding HasError}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding Id}" Classes="mono" FontSize="11"
                           VerticalAlignment="Center" Opacity="0.6" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
      <TextBlock Text="{Binding StatusMessage}" Classes="mono" VerticalAlignment="Center" />
      <TextBlock Classes="mono" VerticalAlignment="Center" Margin="16,0,0,0">
        <Run Text="stale:" />
        <Run Text="{Binding StaleCount, Mode=OneWay}" />
        <Run Text="   selected:" />
        <Run Text="{Binding SelectedCount, Mode=OneWay}" />
      </TextBlock>
    </StackPanel>
  </Grid>
</UserControl>
