<UserControl x:Class="LiveClaude.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Logs" Style="{StaticResource Heading}" />
      <TextBlock Style="{StaticResource SubHeading}"
                 Text="Everything the supervised server printed, with escape sequences stripped. Full files live under %ProgramData%\LiveClaude\logs." />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
      <ComboBox x:Name="InstancePicker" Width="260" ItemsSource="{Binding Instances}" DisplayMemberPath="Name"
                SelectionChanged="OnInstancePicked" />
      <Button Content="Refresh" Click="OnRefresh" Margin="10,0,0,0" />
      <Button Content="Open logs folder" Command="{Binding OpenLogFolderCommand}" />
      <CheckBox x:Name="AutoRefresh" Content="Auto-refresh" IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center" />
    </StackPanel>

    <Border Grid.Row="2" CornerRadius="10" Background="#0C0C0C" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" Padding="10">
      <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
               FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#CFD6DE"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               TextWrapping="NoWrap" AcceptsReturn="True" />
    </Border>
  </Grid>
</UserControl>
