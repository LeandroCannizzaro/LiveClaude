<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>LiveClaude</AssemblyName>
    <RootNamespace>LiveClaude.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\liveclaude.ico</ApplicationIcon>
    <!-- Needed by the ClickOnce profile and the self-contained release builds. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shown in the About window. -->
    <Resource Include="Assets\liveclaude.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveClaude.Core\LiveClaude.Core.csproj" />
    <ProjectReference Include="..\LiveClaude.Terminal\LiveClaude.Terminal.csproj" />
    <ProjectReference Include="..\LiveClaude.Service\LiveClaude.Service.csproj" />
  </ItemGroup>

</Project>
