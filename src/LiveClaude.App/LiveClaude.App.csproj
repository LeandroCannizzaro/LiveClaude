<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LiveClaude</AssemblyName>
    <RootNamespace>LiveClaude.App</RootNamespace>
    <ApplicationIcon>Assets\liveclaude.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.0" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveClaude.Abstractions\LiveClaude.Abstractions.csproj" />
    <ProjectReference Include="..\LiveClaude.Core\LiveClaude.Core.csproj" />
    <ProjectReference Include="..\LiveClaude.Terminal\LiveClaude.Terminal.csproj" />
    <ProjectReference Include="..\LiveClaude.Service\LiveClaude.Service.csproj" />
  </ItemGroup>

  <Import Project="..\..\build\PlatformAssemblies.props" />

</Project>
