<?xml version="1.0" encoding="utf-8"?>
<!--
  ClickOnce publish profile for LiveClaude 2.x.

  Build it with MSBuild (not `dotnet publish`):
    msbuild src\LiveClaude.App\LiveClaude.App.csproj /t:Publish /p:PublishProfile=ClickOnce /p:Configuration=Release

  This publishes to a channel of its own, .../clickonce/v2/, and the 1.x channel at .../clickonce/
  is left frozen at 1.0.15. That is deliberate: 1.x is the Windows-only WPF program, 2.x is the
  cross-platform one, and an existing 1.0.15 install must keep working and keep being offered 1.0.15
  rather than being carried onto a different application by an update check.

  The two are separate deployments because ClickOnce keys an installation on its update URL. They
  also carry different product names so they are distinguishable in Add/Remove Programs.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>..\..\artifacts\clickonce\</PublishDir>
    <PublishUrl>https://leandrocannizzaro.github.io/LiveClaude/clickonce/v2/</PublishUrl>
    <InstallUrl>https://leandrocannizzaro.github.io/LiveClaude/clickonce/v2/</InstallUrl>
    <UpdateUrl>https://leandrocannizzaro.github.io/LiveClaude/clickonce/v2/</UpdateUrl>
    <Install>true</Install>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <CreateWebPageOnPublish>true</CreateWebPageOnPublish>
    <WebPage>index.html</WebPage>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>2.0.0.*</ApplicationVersion>
    <!-- No prerequisite bootstrapper: the page links the .NET 10 runtime instead. -->
    <BootstrapperEnabled>false</BootstrapperEnabled>
    <SignManifests>false</SignManifests>
    <GenerateManifests>true</GenerateManifests>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <ProductName>LiveClaude 2</ProductName>
    <PublisherName>Leandro Cannizzaro</PublisherName>
    <SupportUrl>https://github.com/LeandroCannizzaro/LiveClaude</SupportUrl>
  </PropertyGroup>
</Project>
