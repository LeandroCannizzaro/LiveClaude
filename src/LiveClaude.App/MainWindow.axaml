<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:LiveClaude.App.Views"
        x:Class="LiveClaude.App.MainWindow"
        Title="LiveClaude" Height="820" Width="1280"
        MinHeight="640" MinWidth="1000"
        Icon="avares://LiveClaude/Assets/liveclaude.ico"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="20,16,20,16" RowDefinitions="Auto,*">

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,14" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="LiveClaude" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="{Binding AppVersion}" FontSize="15" Foreground="{DynamicResource MutedTextBrush}"
                     VerticalAlignment="Center" Margin="8,2,0,0" />
          <Border Classes="pill" Margin="12,2,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding ConnectionText}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" />
          </Border>
        </StackPanel>
        <TextBlock Text="{Binding ClaudeInfo}" Classes="mono" Margin="0,6,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="{Binding UpdateButtonText}" Command="{Binding UpdateCommand}"
                Classes="primary" IsVisible="{Binding HasUpdateAvailable}" />
        <Button Content="{Binding UpdateButtonText}" Command="{Binding UpdateCommand}"
                IsVisible="{Binding !HasUpdateAvailable}" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        <Button Content="About" Click="OnShowAbout" Margin="0"
                ToolTip.Tip="About LiveClaude — version, license and credits" />
      </StackPanel>
    </Grid>

    <!-- Tabs -->
    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
      <TabItem Header="Dashboard">
        <views:DashboardView />
      </TabItem>
      <TabItem Header="Sessions">
        <views:SessionsView />
      </TabItem>
      <TabItem Header="Terminal">
        <views:TerminalPane Name="TerminalTab" />
      </TabItem>
      <TabItem Header="Logs">
        <views:LogsView />
      </TabItem>
      <TabItem Header="Environments" IsVisible="{Binding ShowEnvironmentsTab}">
        <views:EnvironmentsView />
      </TabItem>
      <TabItem Header="Service &amp; startup">
        <views:SettingsView />
      </TabItem>
      <TabItem Header="Settings">
        <views:AppSettingsView />
      </TabItem>
    </TabControl>
  </Grid>
</Window>
