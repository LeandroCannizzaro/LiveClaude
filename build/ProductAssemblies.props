<Project>

  <!--
    Puts every LiveClaude.Product.*.dll next to the output, without referencing them from Core.
    Mirrors PlatformAssemblies.props: build ordering only, then copy by GetTargetPath.
  -->

  <PropertyGroup>
    <_LiveClaudeSrc>$(MSBuildThisFileDirectory)..\src\</_LiveClaudeSrc>
  </PropertyGroup>

  <ItemGroup>
    <LiveClaudeProductProject Include="$(_LiveClaudeSrc)LiveClaude.Product.Claude\LiveClaude.Product.Claude.csproj" />
    <LiveClaudeProductProject Include="$(_LiveClaudeSrc)LiveClaude.Product.Cursor\LiveClaude.Product.Cursor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="@(LiveClaudeProductProject)"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      UndefineProperties="TargetFramework;RuntimeIdentifier;SelfContained;PublishDir;PublishSingleFile;PublishReadyToRun"
                      Private="false" />
  </ItemGroup>

  <Target Name="ResolveLiveClaudeProductAssemblies"
          Condition="'@(LiveClaudeProductProject)' != ''">
    <MSBuild Projects="@(LiveClaudeProductProject)"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;PublishDir;PublishSingleFile;PublishReadyToRun">
      <Output TaskParameter="TargetOutputs" ItemName="LiveClaudeProductAssembly" />
    </MSBuild>
  </Target>

  <Target Name="CopyLiveClaudeProductAssemblies"
          AfterTargets="Build"
          DependsOnTargets="ResolveLiveClaudeProductAssemblies"
          Condition="'@(LiveClaudeProductProject)' != ''">
    <Copy SourceFiles="@(LiveClaudeProductAssembly)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishLiveClaudeProductAssemblies"
          AfterTargets="Publish"
          DependsOnTargets="ResolveLiveClaudeProductAssemblies"
          Condition="'@(LiveClaudeProductProject)' != ''">
    <Copy SourceFiles="@(LiveClaudeProductAssembly)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Same ClickOnce trap as the platform assemblies: copying into PublishDir after Publish leaves the
    DLLs on disk but out of the .manifest, so a ClickOnce install never fetches them. Without the
    product assemblies ProductHost is empty, Settings shows no Claude/Cursor installs, and the
    supervisor reports both CLIs as missing even when they are on the machine. Add them to
    @(ReferenceCopyLocalPaths) before ClickOnce freezes its file list.
  -->
  <Target Name="AddLiveClaudeProductAssembliesToClickOnceManifest"
          BeforeTargets="_DeploymentComputeClickOnceManifestInfo"
          DependsOnTargets="ResolveLiveClaudeProductAssemblies"
          Condition="'$(GenerateClickOnceManifests)' == 'true' and '@(LiveClaudeProductProject)' != ''">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="@(LiveClaudeProductAssembly)" />
    </ItemGroup>
  </Target>

</Project>
