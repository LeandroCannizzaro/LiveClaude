<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LiveClaude.Abstractions\LiveClaude.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\LiveClaude.Core\LiveClaude.Core.csproj" />
    <ProjectReference Include="..\..\src\LiveClaude.Vt\LiveClaude.Vt.csproj" />

    <!--
      The POSIX assemblies are referenced here, unlike everywhere else, because what they produce —
      a systemd unit, a launchd property list, a quoted command line — is a pure function of its
      input and worth asserting on every operating system. A unit file that is wrong announces itself
      at the next reboot; a test that only runs on the machine which would have caught it is no help.
      These are net10.0 like this project, so referencing them costs nothing.
    -->
    <ProjectReference Include="..\..\src\LiveClaude.Platform.Posix\LiveClaude.Platform.Posix.csproj" />
    <ProjectReference Include="..\..\src\LiveClaude.Platform.Linux\LiveClaude.Platform.Linux.csproj" />
    <ProjectReference Include="..\..\src\LiveClaude.Platform.MacOS\LiveClaude.Platform.MacOS.csproj" />
  </ItemGroup>

  <!--
    These exercise the platform assembly itself — the pseudo terminal, the IPC endpoint, the command
    line quoting — so they need the one for the OS they run on. Each test states which platforms it
    applies to and skips elsewhere, so the whole project runs everywhere without being green by
    running nothing.
  -->
  <Import Project="..\..\build\PlatformAssemblies.props" />

</Project>
